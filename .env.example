# =========================================================================
# Supabase Environment Variables Template
# 
# Copy this file to '.env' and fill in the values.
# DO NOT commit '.env' containing actual keys/secrets to GitHub.
# =========================================================================

# [DEVELOPMENT ENVIRONMENT]
# Supabase Dev Project URL (club-erp-dev)
VITE_SUPABASE_URL_DEV=your_dev_supabase_url

# Supabase Dev Project Anon Public Key (club-erp-dev)
VITE_SUPABASE_ANON_KEY_DEV=your_dev_supabase_anon_key


# [PRODUCTION ENVIRONMENT]
# Supabase Prod Project URL (club-erp-prod)
VITE_SUPABASE_URL_PROD=your_prod_supabase_url

# Supabase Prod Project Anon Public Key (club-erp-prod)
VITE_SUPABASE_ANON_KEY_PROD=your_prod_supabase_anon_key


# [SECURITY / EDGE FUNCTIONS]
# Supabase Service Role Key (Edge Function only, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
